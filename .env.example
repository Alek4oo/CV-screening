# Копирай като .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=cvscreening
POSTGRES_PASSWORD=cvscreening
POSTGRES_DB=cvscreening
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Хостът "db" е името на услугата в docker-compose.
DATABASE_URL=postgresql+psycopg2://cvscreening:cvscreening@db:5432/cvscreening

# Създава липсващите таблици при старт. Временно, докато няма Alembic —
# изключи го, щом миграциите влязат.
AUTO_CREATE_TABLES=true

# Качване на CV
# Приемаме само PDF и TXT (виж allowed_upload_types в app/core/config.py).
MAX_UPLOAD_BYTES=10485760

# OCR
# Ключ от регистъра в app/ocr/__init__.py — смяната на адаптер е смяна тук.
OCR_BACKEND=tesseract
OCR_LANGUAGES=bul+eng
OCR_DPI=300
# Само ако бинарникът не е на PATH (в образа е).
# TESSERACT_CMD=/usr/bin/tesseract
